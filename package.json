{
  "name": "wwde-nvh-sonoscope",
  "version": "1.0.0",
  "private": true,
  "description": "WWDE NVH Sonoscope - a calibrated smartphone acoustic measurement tool (PWA)",
  "author": "Mandip Goswami <gomandip@amazon.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "gen:assets": "node scripts/generate-assets.mjs",
    "build:worklet": "node scripts/build-worklet.mjs",
    "build:sw": "node scripts/build-sw.mjs",
    "report:dsp": "node scripts/dsp-report.mjs",
    "prepare:static": "npm run gen:assets && npm run build:worklet && npm run build:sw",
    "predev": "npm run prepare:static",
    "dev": "next dev",
    "prebuild": "npm run prepare:static",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
